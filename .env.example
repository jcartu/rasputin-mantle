# ============================================================
# Rasputin Mantle — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the required values.
# Lines prefixed with # are commented out (optional features).

# --- Database ---
POSTGRES_USER=mantle
POSTGRES_PASSWORD=mantle-dev
POSTGRES_DB=mantle
# Full connection string (alternative to individual vars):
DATABASE_URL=postgresql://mantle:mantle-dev@postgres:5432/mantle

# --- Cache ---
MANTLE_REDIS_URL=redis://redis:6379/0

# --- Local LLM (vLLM on host) ---
# vLLM runs separately on the host. Gateway reaches it via this URL.
# On Docker: use http://host.docker.internal:<port>
VLLM_BASE_URL=http://host.docker.internal:8001
VLLM_MODEL=qwen3.6-27b
VLLM_API_KEY=

# --- API Keys (required for full feature parity) ---
# Get key at https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# --- Gateway ---
# URL the web frontend uses to reach the gateway API.
MANTLE_GATEWAY_URL=http://localhost:8000
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8000
MANTLE_PUBLIC=false
MANTLE_PORT=8000
MANTLE_DEBUG=false

# --- Runtime ---
MANTLE_EVAL_MODE=0
MANTLE_SKILLS_DIR=skills
MANTLE_SANDBOX_BACKEND=docker
MANTLE_FILES_ROOT=/workspace
MANTLE_KB_ROOT=/workspace/projects
MANTLE_MAX_COST=40.0
MANTLE_MAX_TOKENS=1000000
MANTLE_BROWSER_BACKEND=agent-browser
MANTLE_E2B=
MANTLE_SESSION_ID=
MANTLE_SCHEDULER_JOBS_KEY=apscheduler.jobs
MANTLE_SCHEDULER_RUN_TIMES_KEY=apscheduler.run_times

# --- Neko / Sandbox ---
MANTLE_NEKO_BASE_URL=http://127.0.0.1:8080
MANTLE_NEKO_URL_TEMPLATE=
NEXT_PUBLIC_NEKO_URL=

# --- Voice (STT/TTS) ---
WHISPER_URL=http://127.0.0.1:8803
KOKORO_URL=http://127.0.0.1:8804

# --- Slack Integration (optional) ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=

# --- Email Integration (optional) ---
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_IMAP_USER=
MAIL_IMAP_PASSWORD=
MAIL_ALLOWED_SENDERS=
MAIL_INBOX_ADDRESS=
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=

# --- Wide Research (optional) ---
BRAVE_SEARCH_API_KEY=
EXA_API_KEY=

# --- Memory / Rasputin (optional) ---
RASPUTIN_URL=http://127.0.0.1:7777
RASPUTIN_TOKEN=
RASPUTIN_MEMORY_URL=
RASPUTIN_BANK_ID=
MEMORY_API_URL=
MEMORY_API_HOST=localhost:7777
MEMORY_API_TOKEN=

# --- MCP Server (optional) ---
MCP_HOST=127.0.0.1
MCP_PORT=8808

# --- DeepSeek (optional, fallback model) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Cost Guards ---
MANTLE_DAILY_ANTHROPIC_CAP_USD=50
MANTLE_DAILY_DEEPSEEK_CAP_USD=20

# --- Content Generation (LLM for productivity skills) ---
MANTLE_CONTENT_VLLM_BASE_URL=
MANTLE_CONTENT_VLLM_MODEL=

# --- WebVoyager / Eval (optional) ---
JUDGE_MODEL=claude-sonnet-4-6
