{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rasputin Mantle",
  "version": "1.3.0",
  "identifier": "dev.mantle.rasputin",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Rasputin Mantle",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "msi", "nsis", "deb", "rpm", "appimage"],
    "category": "Productivity",
    "createUpdaterArtifacts": true,
    "icon": [
      "src-tauri/icons/32x32.png",
      "src-tauri/icons/128x128.png",
      "src-tauri/icons/128x128@2x.png",
      "src-tauri/icons/icon.icns",
      "src-tauri/icons/icon.ico",
      "src-tauri/icons/icon.png"
    ],
    "macOS": {
      "signingIdentity": null,
      "hardenedRuntime": true,
      "entitlements": null,
      "exceptionDomain": "mantle.dev"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "TAURI_UPDATER_PUBLIC_KEY_STUB_REPLACE_BEFORE_RELEASE",
      "endpoints": [
        "https://updates.mantle.dev/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
