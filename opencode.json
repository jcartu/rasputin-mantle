{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["oh-my-opencode@latest"],

  "instructions": [
    "docs/RASPUTIN_MANTLE_BUILD_PLAN.md",
    "docs/AUDIT_LOOP.md",
    ".opencode/skills/mantle-build/SKILL.md"
  ],

  "provider": {
    "local-vllm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local vLLM (Qwen3.6-27B)",
      "options": {
        "baseURL": "{env:VLLM_BASE_URL}/v1",
        "apiKey": "{env:VLLM_API_KEY}"
      },
      "models": {
        "qwen3.6-27b": {
          "name": "Qwen3.6 27B Instruct",
          "limit": { "context": 131072, "output": 16384 },
          "parameters": { "temperature": 0.2, "top_p": 0.95 }
        }
      }
    }
  },

  "default_agent": "build",

  "agent": {
    "build": {
      "model": "anthropic/claude-opus-4-7"
    }
  },

  "share": "manual",
  "autoupdate": "notify"
}
