          "script": "(() => {\n  // Dismiss the cookie banner if present without relying on pointer clicks\n  const reject = document.querySelector('[data-testid=\"reject-button\"]');\n  if (reject) reject.click();\n\n  const text = document.body.innerText || '';\n  const tables = [...document.querySelectorAll('table')].map((table, ti) => ({\n    index: ti,\n    caption: table.caption?.innerText || '',\n    headers: [...table.querySelectorAll('th')].map(th => th.innerText.trim()),\n    rows: [...table.querySelectorAll('tbody tr, tr')].slice(0, 10).map(tr => [...tr.querySelectorAll('th,td')].map(td => td.innerText.trim()).filter(Boolean))\n  }));\n\n  const snippets = [];\n  for (const term of ['Premier League Table', 'Premier League', 'Position', 'Team']) {\n    const i = text.indexOf(term);\n    if (i >= 0) snippets.push(text.slice(Math.max(0, i - 500), i + 2500));\n  }\n\n  return { tables, snippets, bodyStart: text.slice(0, 3000) };\n})()"
        }
      },
