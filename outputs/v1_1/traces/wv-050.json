          "script": "(() => {\n  const rows = [...document.querySelectorAll('tr.athing')];\n  const stories = rows.map((tr, i) => {\n    const title = tr.querySelector('.titleline a')?.innerText || '';\n    const href = tr.querySelector('.titleline a')?.href || '';\n    const sub = tr.nextElementSibling?.innerText || '';\n    return {i: i+1, id: tr.id, title, href, sub, rust: /rust/i.test(title + ' ' + href + ' ' + sub)};\n  });\n  const more = document.querySelector('a.morelink')?.href || null;\n  return {url: location.href, stories, matches: stories.filter(s => s.rust), more};\n})()"
        }
