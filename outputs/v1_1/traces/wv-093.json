          "script": "(() => {\n  const selectors = [\n    '[data-testid=\"UserDescription\"]',\n    '[data-testid=\"UserName\"]',\n    '[data-testid=\"UserProfileHeader_Items\"]'\n  ];\n  const out = {};\n  for (const s of selectors) out[s] = Array.from(document.querySelectorAll(s)).map(e => e.innerText);\n  const text = document.body.innerText;\n  const idx = text.indexOf('@NASA');\n  out.bodySnippet = idx >= 0 ? text.slice(Math.max(0, idx - 100), idx + 500) : text.slice(0, 1000);\n  return JSON.stringify(out);\n})()"
